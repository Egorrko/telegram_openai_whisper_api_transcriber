# Runtime environment for the OTP release.
#
# Nothing in this project auto-loads a .env file. Use it with
# `docker run --env-file .env`, docker compose, or your process manager.
# In development, config/dev.exs already has working defaults and none of
# these are required.

# ---------------------------------------------------------------------------
# Required by the release (config/runtime.exs). Boot fails without them.
# ---------------------------------------------------------------------------

# Postgres connection for the release.
DATABASE_URL=ecto://postgres:postgres@localhost/telegram_voice_transcriber_ash_prod

# Generate with `mix phx.gen.secret`.
SECRET_KEY_BASE=

# Signs AshAuthentication tokens. Generate with `mix phx.gen.secret`.
# Rotating this invalidates every existing operator session.
TOKEN_SIGNING_SECRET=

# Public hostname used to build URLs.
PHX_HOST=localhost

# ---------------------------------------------------------------------------
# Optional, with defaults
# ---------------------------------------------------------------------------

# HTTP port. Default 4000.
PORT=4000

# Database pool size. Default 10.
POOL_SIZE=10

# Set to "true" when the database is reachable only over IPv6.
# ECTO_IPV6=

# libcluster DNS discovery query. Unset disables clustering.
# DNS_CLUSTER_QUERY=

# Error tracking. Unset leaves Sentry inert; it does not block boot.
# SENTRY_DSN=

# Operator console (AshAdmin at /admin, Oban Web at /oban). Both answer 404
# until OPERATOR_USERNAME is set; setting it without OPERATOR_PASSWORD refuses
# to boot. In development the credentials default to operator / operator.
# OPERATOR_USERNAME=
# OPERATOR_PASSWORD=

# ---------------------------------------------------------------------------
# The bot. Names and semantics are identical to the source Django bot, so an
# existing .env keeps working. Variables marked "not read yet" belong to
# slices that are not implemented; see docs/REPLATFORM_ANALYSIS.md.
# ---------------------------------------------------------------------------

# Telegram bot token from @BotFather. Unset leaves the bot stopped and the
# web endpoint running on its own.
# TELEGRAM_TOKEN=

# Base URL of a self-hosted telegram-bot-api server. Unset uses the public API,
# which caps file downloads at 20 MB. Moving to a local server requires a
# one-time logout call against the public API first.
# Not read yet: downloads still go through the public API's URL scheme.
# TELEGRAM_BOT_API_URL=http://telegram-bot-api:8081

# Primary transcription engine, and the engine tried once after the primary
# exhausts its retries. See analysis section 8 for the full engine list.
# TRANSCRIPTION_ENGINE=gemini-3.5-flash-lite
# FALLBACK_TRANSCRIPTION_ENGINE=

# OPENAI_API_KEY=
# ELEVENLABS_API_KEY=
# GEMINI_API_KEY=

# Bot handle. A group reply that mentions it triggers transcription.
# BOT_USERNAME=

# Contact shown by /paysupport, which Telegram requires for Stars payments.
# SUPPORT_USERNAME=@durov

# Free allowance granted per 30-day period, and the balance at which the user
# is warned once. Defaults are 30 and 10.
# AVAILABLE_MINUTES=30
# LEFT_WARNING_MINUTES=10

# How many minutes one Telegram Star buys. Default 10.
# CURRENCY_RATE=10

# Comma-separated short chat IDs. Both lists are transformed with
# -(1_000_000_000_000 + id) to form supergroup IDs — keep that contract.
# ALLOWED_CHAT_IDS lists groups where voice is transcribed automatically.
# FORWARD_CHAT_IDS lists groups whose voice is forwarded to ADMIN_ID.
# ALLOWED_CHAT_IDS=
# FORWARD_CHAT_IDS=

# Raw Telegram user ID of the operator receiving forwarded messages.
# ADMIN_ID=

# Retry budget for the primary transcription engine. Backoff is linear:
# RETRY_DELAY * attempt seconds. Defaults are 3 and 1.
# MAX_RETRIES=3
# RETRY_DELAY=1

# Not read yet. Outbound proxy for reaching Telegram and the providers.
# Undocumented in the source repository but required by its docker-compose.
# PROXY_USERNAME=
# PROXY_PASSWORD=
# PROXY_HOST=
# PROXY_PORT=
